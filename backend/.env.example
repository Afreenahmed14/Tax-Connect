CLOUDINARY_URL=

# Firebase (FCM)
FIREBASE_SERVICE_ACCOUNT_PATH=./firebase-service-account.json

# Email
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=

# Optional / future
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
