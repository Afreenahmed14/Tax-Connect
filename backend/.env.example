NODE_ENV=development
PORT=5000
MONGO_URI=mongodb://127.0.0.1:27017/tax_connect

JWT_SECRET=change_me
JWT_EXPIRES_IN=7d
OTP_EXPIRY_MINUTES=5

# Storage: s3 | cloudinary
STORAGE_PROVIDER=s3
AWS_REGION=ap-south-1
AWS_BUCKET=
AWS_ACCESS_KEY_ID=
